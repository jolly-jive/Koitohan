server ldap-pap {
	namespace = radius
	listen authentication {
		type = Access-Request
		type = Status-Server
		transport = udp
		require_message_authenticator = auto
		udp {
			ipaddr = *
			port = 1812
			# The source is limited (DEVICE_NETWORKS of .env) by the
			# packet filter of the container (freeradius/build/entrypoint.sh).
			# The "networks" section here would apply to dynamic
			# clients only.
		}
	}
	recv Access-Request {
		auth_log
		control.Auth-Type := 'ldap_auth'
		filter_username
		ldap
		authz_vendor_role
	}
	authenticate ldap_auth {
		ldap
	}
	recv Status-Server {
		ok
	}
	send Access-Accept {
		#authz_vendor_role
		reply += session-state
		reply_log
	}
	send Access-Reject {
		attr_filter.access_reject
		delay_reject
	}
}
